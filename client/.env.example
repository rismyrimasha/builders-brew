# Local dev and same-origin deploys: leave this unset.
#   - dev: Vite proxies /api to http://127.0.0.1:4000 (see vite.config.js)
#   - same-origin: run the server with SERVE_CLIENT=true
#
# Split deploy (client on a static host, API on another domain): set the full
# API base URL, including the /api suffix. Vite only reads VITE_-prefixed vars,
# and this is baked in at build time — rebuild after changing it.
# VITE_API_URL=https://api.buildersbrew.example/api
