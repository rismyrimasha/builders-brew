PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/builders-brew

# REQUIRED. The server refuses to start unless this is a strong random value
# (>= 32 chars, and not this example). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin of the client app. Used for CORS and the API-only landing response.
# Ignored when SERVE_CLIENT=true (client is same-origin then).
CLIENT_ORIGIN=http://localhost:5173

# true  -> Express serves client/dist from this same origin (build the client first)
# false -> API only; host the client separately (set VITE_API_URL in the client build)
SERVE_CLIENT=false

NOTIFY_USER_ID=
NOTIFY_API_KEY=
NOTIFY_SENDER_ID=NotifyDEMO
SMS_ENABLED=true
